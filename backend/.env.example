# Copy to backend/.env and fill in real values. Never commit the result.
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Local development. Tables are created automatically outside production.
DATABASE_URL=sqlite+pysqlite:///./courier_dev.db

# Aiven MySQL. Use the *Service URI* connection details from the Aiven console.
# DATABASE_URL=mysql+pymysql://avnadmin:PASSWORD@mysql-xxxx.aivencloud.com:12345/defaultdb
# Download https://console.aiven.io CA certificate to backend/ca.pem, then:
# DB_SSL_CA=./ca.pem

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://courierpl.netlify.app

# Creates the first administrator on startup when the email is free.
# The bootstrap account is the only way to create staff accounts at first.
BOOTSTRAP_ADMIN_EMAIL=admin@courier.dev
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-2026!
BOOTSTRAP_ADMIN_NAME=System Administrator

PUBLIC_RATE_LIMIT_PER_MINUTE=60
