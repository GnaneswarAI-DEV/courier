# =============================================================================
# Root environment reference for the courier platform
# =============================================================================
# Copy the relevant block into backend/.env or frontend/.env — the apps read
# their own files. This root file documents every variable in one place and is
# used by docker-compose.
#
# NEVER commit real credentials.
# =============================================================================

# ---------------------------------------------------------------- backend ---
ENVIRONMENT=development          # development | testing | production
DEBUG=false
LOG_LEVEL=INFO

# Random value, at least 32 chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Local development (SQLite):
DATABASE_URL=sqlite+pysqlite:///./courier_dev.db
# Aiven MySQL example (URL-encode special characters in the password):
# DATABASE_URL=mysql+pymysql://avnadmin:CHANGE_ME@mysql-xxxx.aivencloud.com:12345/defaultdb
# Path to the CA certificate Aiven provides; enables TLS verification.
DB_SSL_CA=

# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional first administrator, created on startup if the account is missing.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Administrator

# Requests per minute per IP for public tracking and auth endpoints.
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# --------------------------------------------------------------- frontend ---
# Leave empty in development to use the Vite proxy (/api -> localhost:8000).
# In production point this at the deployed API, including /api/v1.
VITE_API_BASE_URL=
# Example: VITE_API_BASE_URL=https://courier-parcel-tracking-07vm.onrender.com/api/v1

# ------------------------------------------------------------------ local ---
# Used by docker-compose only.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=courier
MYSQL_USER=courier
MYSQL_PASSWORD=change-me-app
